# Copia este archivo como .env y completa tus propios valores.
# NUNCA subas .env con credenciales reales al repositorio.

# auto | supabase | sqlite
DB_BACKEND=auto

# Tu proyecto de Supabase (URL y clave; se recomienda service_role solo en local)
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=PEGAR_AQUI_TU_CLAVE_DE_SUPABASE

# Solo se usa con DB_BACKEND=sqlite
DATABASE_PATH=data/universidad_horarios.db

# Secreto de sesión de Flask (cambia por una cadena larga y aleatoria)
FLASK_SECRET_KEY=CAMBIAR_POR_UN_SECRETO_ALEATORIO

# Puerto del modo servidor (opcional; por defecto 5000/8000)
UNESR_PORT=5000
